// GitHub Codespaces setup: runs the Anubis demo in GitHub's cloud.
// When the codespace starts, it installs Docker and jq, then runs
// `docker compose up -d`. The demo is on port 8888.
// To let other people open it, set port 8888 to Public in the Ports tab.
{
  "name": "Anubis demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // jq is only needed for demo/watch-log.sh
  "postCreateCommand": "command -v jq >/dev/null || (sudo apt-get update -q && sudo apt-get install -y -q jq)",
  // wait for Docker to be ready, then start Anubis and nginx
  "postStartCommand": "bash -c 'for i in $(seq 1 60); do docker info >/dev/null 2>&1 && break; sleep 2; done; docker compose up -d'",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "Anubis demo", "onAutoForward": "notify" }
  }
}
